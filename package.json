{
  "name": "r3nginemobile",
  "main": "expo-router/entry",
  "version": "1.6.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:eas": "npx eas build -p android --profile production",
    "build:dev": "cd android && gradlew assembleDebug && cd .. && node -e \"const v=require('./package.json').version,fs=require('fs'),{execSync}=require('child_process'),n='r3NgineMobile-v'+v+'-debug.apk';fs.mkdirSync('.build',{recursive:true});fs.copyFileSync('android/app/build/outputs/apk/debug/app-debug.apk','.build/'+n);execSync('bash .build/generate-checksum.sh .build/'+n,{stdio:'inherit'})\"",
    "build:prod": "cd android && gradlew assembleRelease && cd .. && node -e \"const v=require('./package.json').version,fs=require('fs'),{execSync}=require('child_process'),n='r3NgineMobile-v'+v+'.apk';fs.mkdirSync('.build',{recursive:true});fs.copyFileSync('android/app/build/outputs/apk/release/app-release.apk','.build/'+n);execSync('bash .build/generate-checksum.sh .build/'+n,{stdio:'inherit'})\"",
    "checksum": "bash .build/generate-checksum.sh",
    "generate-api": "npx openapi-typescript openapi.json -o src/types/api.ts",
    "test": "jest"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.ts"
    ]
  },
  "dependencies": {
    "@expo-google-fonts/bangers": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@fontsource/bangers": "^5.2.8",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.1.8",
    "@tanstack/react-query": "^5.100.9",
    "axios": "^1.16.0",
    "date-fns": "^4.1.0",
    "eas-cli": "^18.12.1",
    "expo": "~54.0.35",
    "expo-background-task": "~1.0.10",
    "expo-build-properties": "~1.0.10",
    "expo-clipboard": "^56.0.4",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-modules-core": "~3.0.30",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-task-manager": "~14.0.9",
    "expo-web-browser": "~15.0.10",
    "lucide-react-native": "^1.14.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.0",
    "axios-mock-adapter": "^2.1.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "openapi-typescript": "^7.13.0",
    "react-test-renderer": "19.1.0",
    "swagger2openapi": "^7.0.8",
    "ts-jest": "^29.4.9",
    "typescript": "~5.9.2"
  },
  "private": true,
  "overrides": {
    "react-native": "0.81.5",
    "@react-native/virtualized-lists": "0.81.5"
  }
}